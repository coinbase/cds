{
  "extends": "../../tsconfig.project.json",
  "compilerOptions": {
    "jsx": "react-native",
    "resolveJsonModule": true,
    "moduleSuffixes": [
      ".ios",
      ".android",
      ".native",
      ""
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "references": [
    {
      "path": "../../packages/common"
    },
    {
      "path": "../../packages/mobile"
    },
    {
      "path": "../../packages/icons"
    },
    {
      "path": "../../packages/illustrations"
    }
  ]
}
