<?xml version="1.0" encoding="UTF-8"?>
<Workspace
   version = "1.0">
   <!--
     Reference only the app project. It declares a local SwiftPM dependency on
     ../../packages/cds-ios, so Xcode resolves and shows CDSDesignSystem under the app's
     "Package Dependencies" (its sources stay editable in place). Do NOT also add the package
     folder as a separate FileRef here: that duplicates the package reference and triggers
     "Missing package product 'CDSDesignSystem'" in the GUI (xcodebuild dedupes it, Xcode does not).
   -->
   <FileRef
      location = "group:../apps/ios-gallery/CDSGallery.xcodeproj">
   </FileRef>
</Workspace>
