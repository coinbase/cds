## 4. Styling Approach

### Web: Linaria CSS-in-JS

**CRITICAL**: Always use CSS variables for theme tokens:

```tsx
import { css, cx } from '@linaria/core';

const containerCss = css`
  /* ✅ CORRECT: Use CSS variables */
  padding: var(--space-2);
  background: var(--color-bgPrimary);
  color: var(--color-fgPrimary);
  border-radius: var(--borderRadius-400);
  font-size: var(--fontSize-body);
  
  /* ❌ WRONG: Hardcoded values */
  padding: 16px;
  background: #0052FF;
`;

// Merge classNames in correct order
<div className={cx(
  baseCss,              // 1. Base styles
  isActive && activeCss, // 2. Conditional styles
  className,            // 3. User className prop
  classNames?.root      // 4. Granular overrides
)} />
```

### CSS Variable Naming Convention

```css
/* Colors */
--color-{tokenName}     /* e.g., --color-bgPrimary, --color-fgMuted */

/* Spacing */
--space-{scale}         /* e.g., --space-2, --space-0.5 */

/* Typography */
--fontSize-{font}       /* e.g., --fontSize-body, --fontSize-title1 */
--fontWeight-{font}
--lineHeight-{font}
--fontFamily-{font}

/* Border */
--borderRadius-{size}   /* e.g., --borderRadius-400 */
--borderWidth-{size}

/* Sizing */
--iconSize-{size}       /* e.g., --iconSize-m */
--avatarSize-{size}
--controlSize-{name}

/* Shadows */
--shadow-{level}        /* e.g., --shadow-elevation1 */
```

### Mobile: StyleSheet + Theme

```tsx
import { StyleSheet, type StyleProp, type ViewStyle } from 'react-native';
import { useTheme } from '../hooks/useTheme';

const styles = StyleSheet.create({
  container: { position: 'relative', width: '100%' },
});

const Component = ({ style }: { style?: StyleProp<ViewStyle> }) => {
  const theme = useTheme();
  
  const dynamicStyle = useMemo(() => ({
    backgroundColor: theme.color.bgPrimary,
    padding: theme.space[2],
    borderRadius: theme.borderRadius[400],
  }), [theme]);

  return <View style={[styles.container, dynamicStyle, style]} />;
};
```

